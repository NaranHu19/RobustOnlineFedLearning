{
    "benchmark_config": {
        "device": "cuda",
        "training_seed": 4,
        "nb_training_seeds": 5,
        "nb_clients": 10,
        "nb_honest_clients": 8,
        "f": 2,
        "tolerated_f": 2,
        "size_train_set": 0.8,
        "data_distribution_seed": 0,
        "nb_data_distribution_seeds": 1,
        "data_distribution": {
            "name": "dirichlet_niid",
            "distribution_parameter": 1.0
        },
        "training_algorithm": {
            "name": "RobustOnlineFL",
            "parameters": {
                "aggreg_freq_scale": 1.5,
                "aggreg_mult_scale": 1
            }
        },
        "nb_steps": 5000
    },
    "model": {
        "name": "cnn_cifar",
        "dataset_name": "cifar10",
        "nb_labels": 10,
        "loss": "NLLLoss",
        "learning_rate": 0.25,
        "learning_rate_decay": 0.66,
        "milestones": [],
        "weight_decay": 0.001
    },
    "aggregator": {
        "name": "GeometricMedian",
        "parameters": {
            "nu": 0.0,
            "T": 10,
            "f": 2
        }
    },
    "pre_aggregators": [
        {
            "name": "NNM",
            "parameters": {
                "f": 2
            }
        }
    ],
    "honest_clients": {
        "batch_size": 32
    },
    "attack": {
        "name": "SignFlipping",
        "parameters": {}
    },
    "evaluation_and_results": {
        "evaluation_delta": 50,
        "batch_size_evaluation": 128,
        "evaluate_on_test": true,
        "store_per_client_metrics": true,
        "store_models": true,
        "data_folder": "./data",
        "results_directory": "./results/cifar10",
        "models_directory": "./models/cifar10"
    }
}